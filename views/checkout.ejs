<% pageTitle = 'Complete Payment - EventBook' %>
<%- include('partials/header') %>

<div class="form-page">
  <h1>Complete Your Payment</h1>
  <p class="form-sub">Booking Ref: <strong><%= booking.booking_ref %></strong></p>

  <div class="order-summary">
    <h3><%= event.title %></h3>
    <% if (booking.category_name) { %><p class="category-badge"><%= booking.category_name %></p><% } %>
    <p><%= booking.quantity %> ticket(s) &times; ₹<%= booking.unit_price %></p>
    <p class="total-amount">Total: ₹<%= booking.total_amount %></p>
  </div>

  <% if (error) { %><div class="alert-error"><%= error %></div><% } %>

  <div class="qr-pay-box">
    <h3>Scan &amp; Pay</h3>
    <% if (admin && admin.qr_image) { %>
      <img src="<%= admin.qr_image %>" alt="Payment QR Code" class="qr-image" />
    <% } else { %>
      <div class="alert-error">Payment QR code has not been set up yet. Please contact the organizer.</div>
    <% } %>
    <% if (admin && admin.payment_note) { %>
      <p class="payment-note"><%= admin.payment_note %></p>
    <% } %>
  </div>

  <form action="/checkout/<%= booking.id %>/submit" method="POST" enctype="multipart/form-data" class="card-form">
    <label for="screenshot">Upload Transaction Screenshot <span class="required">*</span></label>
    <input type="file" id="screenshot" name="screenshot" accept="image/*" required />

    <label for="transaction_note">Transaction / UPI Reference ID (optional)</label>
    <input type="text" id="transaction_note" name="transaction_note" placeholder="e.g. UPI Ref No." />

    <button type="submit" class="btn-primary full-width">Submit Payment Proof</button>
  </form>
  <p class="fine-print">Your ticket will be generated once the organizer verifies your payment. You'll be able to check the status on the next page.</p>
</div>

<%- include('partials/footer') %>
