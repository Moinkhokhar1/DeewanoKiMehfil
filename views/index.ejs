<% pageTitle = 'Vertex - Discover Events' %>

<%- include('partials/header') %>

<section class="vertex-home">

  <!-- Hero / Search -->
  <section class="vertex-hero">

    <div class="vertex-hero-content">

      <span class="vertex-eyebrow">
        VERTEX PRESENTS
      </span>

      <h1>
        Discover the<br>
        <span>Mehfil.</span>
      </h1>

      <p>
        Soulful nights. Timeless melodies.<br>
        Experiences worth remembering.
      </p>

      <form action="/" method="GET" class="vertex-search">

        <input
          type="text"
          name="q"
          value="<%= q %>"
          placeholder="Search events, venues, categories..."
          aria-label="Search events"
        />

        <button type="submit">
          Search
          <span>→</span>
        </button>

      </form>

    </div>

  </section>


  <!-- Events -->
  <section class="vertex-events">

    <div class="vertex-section-header">

      <div>
        <span class="vertex-eyebrow">
          UPCOMING EVENTS
        </span>

        <h2>
          Experience the night.
        </h2>
      </div>

      <% if (q) { %>

        <p class="vertex-search-result">
          Results for
          <strong>"<%= q %>"</strong>
        </p>

      <% } %>

    </div>


    <% if (events.length === 0) { %>

      <div class="vertex-empty">

        <span>✦</span>

        <h3>No events found</h3>

        <p>
          <% if (q) { %>
            Nothing matched "<%= q %>".
          <% } else { %>
            New experiences are coming soon.
          <% } %>
        </p>

      </div>

    <% } else { %>

      <div class="vertex-event-grid">

        <% events.forEach(event => { %>

          <a
            class="vertex-event-card"
            href="/event/<%= event.id %>"
          >

            <div class="vertex-event-image">

              <% if (event.imageList.length > 0) { %>

                <img
                  src="<%= event.imageList[0] %>"
                  alt="<%= event.title %>"
                  loading="lazy"
                />

              <% } else { %>

                <div class="vertex-no-image">
                  VERTEX
                </div>

              <% } %>


              <% if (event.category) { %>

                <span class="vertex-event-tag">
                  <%= event.category %>
                </span>

              <% } %>

            </div>


            <div class="vertex-event-body">

              <h3>
                <%= event.title %>
              </h3>


              <% if (event.venue) { %>

                <p class="vertex-event-meta">
                  <span>⌖</span>
                  <%= event.venue %>
                </p>

              <% } %>


              <p class="vertex-event-meta">
                <span>◷</span>
                <%= event.start_date %>

                <% if (
                  event.end_date &&
                  event.end_date !== event.start_date
                ) { %>

                  — <%= event.end_date %>

                <% } %>

              </p>


              <div class="vertex-event-footer">

                <span class="vertex-event-price">
                  ₹<%= event.price %>
                  <small>onwards</small>
                </span>

                <span class="vertex-view">
                  Explore →
                </span>

              </div>

            </div>

          </a>

        <% }) %>

      </div>

    <% } %>

  </section>

</section>

<%- include('partials/footer') %>