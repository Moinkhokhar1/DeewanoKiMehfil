<% pageTitle = 'EventBook - Discover Events' %>
<%- include('partials/header') %>

<section class="search-section">
  <form action="/" method="GET" class="search-form">
    <input type="text" name="q" value="<%= q %>" placeholder="Search events, venues, categories..." />
    <button type="submit">Search</button>
  </form>
</section>

<section class="event-grid">
  <% if (events.length === 0) { %>
    <div class="empty-state">
      <p>No events found<% if (q) { %> for "<%= q %>"<% } %>.</p>
    </div>
  <% } %>
  <% events.forEach(event => { %>
    <a class="event-card" href="/event/<%= event.id %>">
      <div class="event-card-image">
        <% if (event.imageList.length > 0) { %>
          <img src="<%= event.imageList[0] %>" alt="<%= event.title %>" loading="lazy" />
        <% } else { %>
          <div class="no-image">No Image</div>
        <% } %>
        <% if (event.category) { %><span class="event-tag"><%= event.category %></span><% } %>
      </div>
      <div class="event-card-body">
        <h3><%= event.title %></h3>
        <p class="event-meta">📍 <%= event.venue %></p>
        <p class="event-meta">📅 <%= event.start_date %><% if (event.end_date && event.end_date !== event.start_date) { %> - <%= event.end_date %><% } %></p>
        <div class="event-card-footer">
          <span class="event-price">₹<%= event.price %> onwards</span>
          <span class="btn-mini">View Details</span>
        </div>
      </div>
    </a>
  <% }) %>
</section>

<%- include('partials/footer') %>
