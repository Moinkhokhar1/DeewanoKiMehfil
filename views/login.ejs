<% pageTitle = 'Login - Vertex' %>

<%- include('partials/header') %>

<div class="sufi-login-page">

  <!-- Background artwork -->
  <div class="sufi-login-bg"></div>
  <div class="sufi-login-overlay"></div>

  <div class="sufi-login-container">

    <!-- Left: Event branding -->
    <div class="sufi-login-visual">
      <div class="sufi-eyebrow">VERTEX PRESENTS</div>

      <h1>
        An evening of Sufi melodies,<br>
        soulful voices & timeless poetry.
      </h1>
      <p class="sufi-login-visual-sub">
        Join us for an unforgettable night of music and culture.
    </div>

    <!-- Right: Login -->
    <div class="sufi-login-card">

      <div class="login-heading">
        <span class="login-small">WELCOME BACK</span>
        <h2>Enter the Mehfil</h2>
        <p>Login to book your tickets.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST">

        <div class="input-group">
          <label for="email">EMAIL</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= old.email || '' %>"
            placeholder="you@example.com"
            required
            autofocus
          />
        </div>

        <div class="input-group">
          <label for="password">PASSWORD</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            required
          />
        </div>

        <button type="submit" class="sufi-login-btn">
          <span>Enter Mehfil</span>
          <span class="arrow">→</span>
        </button>

      </form>

      <p class="switch-auth">
        New here?
        <a href="/register">Create an account</a>
      </p>

    </div>

  </div>
</div>

<%- include('partials/footer') %>