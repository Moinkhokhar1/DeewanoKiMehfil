<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  />

  <title>
    <%= typeof pageTitle !== 'undefined'
      ? pageTitle
      : 'Vertex - The Band'
    %>
  </title>

  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <header class="topbar">

    <div class="topbar-inner">

      <!-- Vertex Logo -->
      <a href="/" class="brand" aria-label="Vertex Home">

        <img
          src="/assets/IMG_6571.PNG"
          alt="Vertex"
          class="brand-logo"
        />

      </a>


      <!-- Navigation -->
      <nav class="nav-links">

        <% if (buyer) { %>

          <a href="/my-bookings">
            My Bookings
          </a>

          <span class="nav-user">
            Hi, <%= buyer.name.split(' ')[0] %>
          </span>

          <form
            action="/logout"
            method="POST"
            class="inline-form"
          >
            <button
              type="submit"
              class="link-btn"
            >
              Logout
            </button>
          </form>

        <% } else { %>

          <a href="/login">
            Login
          </a>

          <a
            href="/register"
            class="btn-outline-small"
          >
            Sign Up
          </a>

        <% } %>

      </nav>

    </div>

  </header>


  <main class="page-wrap">