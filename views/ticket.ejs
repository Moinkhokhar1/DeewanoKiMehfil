<% pageTitle = 'Your Ticket - Vertex' %>

<%- include('partials/header') %>

<main class="ticket-page">

  <section class="ticket-header">
    <span class="eyebrow">YOUR MEHFIL</span>

    <h1>Your Ticket</h1>

    <p>Your place is reserved. We look forward to welcoming you.</p>
  </section>

  <section class="ticket-card">

    <div class="ticket-preview">
      <img
        src="<%= booking.ticket_image %>"
        alt="Vertex Event Ticket"
      />
    </div>

    <div class="welcome-section">

      <span class="eyebrow">WELCOME TO THE MEHFIL</span>

      <h2>Welcome to a<br>night of Sufi music.</h2>

      <p>
        Your ticket is confirmed. Bring this ticket with you and
        immerse yourself in an evening of music, poetry and
        soulful moments.
      </p>

      <p class="fine-print">
        Present this ticket at entry.
      </p>

    </div>

    <div class="ticket-actions">

      <a
        href="<%= booking.ticket_image %>"
        download="Vertex-Ticket-<%= booking.ticket_code %>.svg"
        class="btn-primary"
      >
        Download Ticket
        <span>→</span>
      </a>

      <button
        type="button"
        onclick="window.print()"
        class="btn-outline"
      >
        Print / Save PDF
      </button>

      <a
        href="/my-bookings"
        class="btn-outline"
      >
        My Bookings
      </a>

    </div>

  </section>

</main>

<%- include('partials/footer') %>